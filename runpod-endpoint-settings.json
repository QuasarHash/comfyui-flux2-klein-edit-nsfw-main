{
  "name": "flux2-klein-edit-nsfw",
  "description": "Klein reference edit + mopMix + Pussy/Nipples FaceDetailer. Same network volume as other Klein endpoints.",
  "template": {
    "deployFrom": "comfyui-flux2-klein-edit-nsfw-main",
    "baseImage": "runpod/worker-comfyui:5.8.4-base + Impact Pack/Subpack + Easy-Use",
    "containerDiskInGb": 15,
    "dockerArgs": ""
  },
  "compute": {
    "gpuTypes": [
      "NVIDIA GeForce RTX 4090",
      "NVIDIA L40",
      "NVIDIA RTX A6000"
    ],
    "gpuCount": 1,
    "allowedCudaVersions": ["12.6", "12.7", "12.8"]
  },
  "scaling": {
    "activeWorkers": 0,
    "maxWorkers": 1,
    "idleTimeoutSeconds": 30,
    "flashboot": true,
    "autoScalingType": "queue_delay",
    "queueDelayThresholdSeconds": 4
  },
  "timeouts": {
    "executionTimeoutSeconds": 1800,
    "jobTtlSeconds": 7200,
    "note": "Edit + anatomy detailers — use same timeout as generate NSFW."
  },
  "advanced": {
    "networkVolumeRequired": true,
    "networkVolumeNote": "Same Klein volume; requires sams/ and ultralytics/bbox/"
  }
}